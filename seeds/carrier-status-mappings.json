{
  "_meta": {
    "description": "Default carrier-status -> canonical Base Shop HQ status mapping. Keys are raw values from carrier statements (case-insensitive, whitespace-trimmed); values are one of the canonical policies.status enum: Draft, Submitted, Pending, Active, Terminated, Potential Lapse. Per-carrier overrides live in carrier_profiles.status_value_map.",
    "canonical_statuses": ["Draft", "Submitted", "Pending", "Active", "Terminated", "Potential Lapse"],
    "matching": "case-insensitive, trimmed"
  },
  "mappings": {
    "Issued": "Active",
    "Issue Paid": "Active",
    "Issued Paid": "Active",
    "First Year Paid": "Active",
    "Inforce": "Active",
    "In Force": "Active",
    "Active": "Active",
    "Submitted": "Submitted",
    "App Submitted": "Submitted",
    "Application Submitted": "Submitted",
    "Pending": "Pending",
    "Pending Underwriting": "Pending",
    "Pending Issue": "Pending",
    "Underwriting": "Pending",
    "Approved": "Pending",
    "Free Look": "Pending",
    "Draft": "Draft",
    "Saved": "Draft",
    "Terminated": "Terminated",
    "Lapsed": "Terminated",
    "Cancelled": "Terminated",
    "Canceled": "Terminated",
    "Surrendered": "Terminated",
    "NTO": "Terminated",
    "Not Taken": "Terminated",
    "Declined": "Terminated",
    "Withdrawn": "Terminated",
    "Potential Lapse": "Potential Lapse",
    "Past Due": "Potential Lapse",
    "Grace Period": "Potential Lapse"
  }
}
